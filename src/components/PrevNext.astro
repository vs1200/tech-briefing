---
import type { NewsEntry } from '../lib/content';
import { formatDateJa } from '../lib/date';
import { newsPath } from '../lib/url';

interface Props {
  prev?: NewsEntry | undefined;
  next?: NewsEntry | undefined;
}

const { prev, next } = Astro.props;
const linkClass =
  'group rounded-xl border border-stone-200 bg-white p-4 transition hover:border-stone-300 hover:shadow-[0_2px_12px_-4px_rgb(0_0_0/0.08)] sm:p-5 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-stone-700';
const labelClass =
  'block text-xs text-stone-500 transition-colors group-hover:text-sky-700 dark:group-hover:text-sky-400';
---

<nav
  class="mt-16 grid grid-cols-2 gap-3 border-t border-stone-200 pt-8 sm:gap-4 dark:border-stone-800"
  aria-label="前後の日付"
>
  {prev ? (
    <a href={newsPath(prev.dateKey)} class={linkClass}>
      <span class={labelClass}>← 前日</span>
      <span class="mt-1 block text-sm font-semibold text-stone-800 sm:text-base dark:text-stone-200">
        {formatDateJa(prev.dateKey)}
      </span>
    </a>
  ) : (
    <div />
  )}
  {next && (
    <a href={newsPath(next.dateKey)} class:list={[linkClass, 'text-right']}>
      <span class={labelClass}>翌日 →</span>
      <span class="mt-1 block text-sm font-semibold text-stone-800 sm:text-base dark:text-stone-200">
        {formatDateJa(next.dateKey)}
      </span>
    </a>
  )}
</nav>

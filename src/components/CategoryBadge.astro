---
import { getCategory, type CategorySlug } from '../data/categories';
import { categoryPath } from '../lib/url';

interface Props {
  slug: CategorySlug;
}

const category = getCategory(Astro.props.slug);
---

<a
  href={categoryPath(category.slug)}
  class="inline-flex items-center rounded-full bg-stone-100 px-2 py-0.5 text-[11px] leading-5 font-medium whitespace-nowrap text-stone-600 transition-colors hover:bg-sky-100 hover:text-sky-800 dark:bg-stone-800 dark:text-stone-400 dark:hover:bg-sky-950 dark:hover:text-sky-300"
>
  {category.name}
</a>

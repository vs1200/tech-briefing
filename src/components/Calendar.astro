---
import { buildMonthGrid } from '../lib/calendar';
import { formatDateJa, formatMonthJa, WEEKDAYS } from '../lib/date';
import { monthPath, newsPath } from '../lib/url';

interface Props {
  monthKey: string;
  dateKeys: Set<string>;
  /** 現在表示中の日付。強調表示する。 */
  current?: string;
  /** 見出しを月別ページへのリンクにする */
  linkTitle?: boolean;
}

const { monthKey, dateKeys, current, linkTitle = true } = Astro.props;
const weeks = buildMonthGrid(monthKey);
const weekdayColor = (i: number) =>
  i === 0 ? 'text-rose-500/80' : i === 6 ? 'text-sky-600/80 dark:text-sky-400/80' : 'text-stone-400';
---

<div class="rounded-xl border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
  <p class="mb-3 text-center text-sm font-bold text-stone-900 dark:text-stone-100">
    {linkTitle ? (
      <a href={monthPath(monthKey)} class="transition-colors hover:text-sky-700 dark:hover:text-sky-300">
        {formatMonthJa(monthKey)}
      </a>
    ) : (
      formatMonthJa(monthKey)
    )}
  </p>
  <table class="w-full table-fixed text-center text-xs tabular-nums">
    <thead>
      <tr>
        {WEEKDAYS.map((w, i) => (
          <th class:list={['pb-1.5 text-[11px] font-medium', weekdayColor(i)]}>{w}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {weeks.map((week) => (
        <tr>
          {week.map((cell) => (
            <td class="p-[3px]">
              {cell &&
                (dateKeys.has(cell.dateKey) ? (
                  <a
                    href={newsPath(cell.dateKey)}
                    aria-label={formatDateJa(cell.dateKey)}
                    aria-current={cell.dateKey === current ? 'page' : undefined}
                    class:list={[
                      'block rounded-md py-1.5 font-semibold transition-colors',
                      cell.dateKey === current
                        ? 'bg-sky-600 text-white dark:bg-sky-500 dark:text-stone-950'
                        : 'bg-sky-50 text-sky-800 hover:bg-sky-100 dark:bg-sky-950/60 dark:text-sky-300 dark:hover:bg-sky-900/70',
                    ]}
                  >
                    {cell.day}
                  </a>
                ) : (
                  <span class="block py-1.5 text-stone-300 dark:text-stone-700">{cell.day}</span>
                ))}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

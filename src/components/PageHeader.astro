---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
}

const { title, eyebrow, description } = Astro.props;
---

<header class="mb-8">
  {eyebrow && <p class="text-xs font-semibold tracking-wider text-sky-700 dark:text-sky-400">{eyebrow}</p>}
  <h1
    class:list={[
      'text-[1.75rem] leading-tight font-bold text-stone-900 sm:text-[2rem] dark:text-stone-50',
      eyebrow && 'mt-2',
    ]}
  >
    {title}
  </h1>
  {description && <p class="mt-3 text-sm leading-relaxed text-stone-500 dark:text-stone-400">{description}</p>}
</header>

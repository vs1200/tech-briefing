---
import type { NewsEntry } from '../lib/content';
import { formatDateJa } from '../lib/date';
import { newsPath } from '../lib/url';

interface Props {
  entry: NewsEntry;
}

const PREVIEW_ITEMS = 3;

const { entry } = Astro.props;
const { items, summary } = entry.data;
---

<article class="group relative min-w-0 rounded-xl border border-stone-200 bg-white p-5 transition hover:border-stone-300 hover:shadow-[0_2px_12px_-4px_rgb(0_0_0/0.08)] sm:p-6 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-stone-700">
  <h2 class="text-lg font-bold text-stone-900 dark:text-stone-50">
    <a href={newsPath(entry.dateKey)} class="after:absolute after:inset-0 after:rounded-xl">
      <time datetime={entry.dateKey}>{formatDateJa(entry.dateKey)}</time>
    </a>
  </h2>
  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-stone-500 dark:text-stone-400">{summary}</p>
  <ol class="mt-4 space-y-1.5 border-t border-stone-100 pt-4 text-sm dark:border-stone-800">
    {items.slice(0, PREVIEW_ITEMS).map((item, i) => (
      <li class="flex min-w-0 gap-2">
        <span class="w-4 shrink-0 text-right text-stone-400 tabular-nums dark:text-stone-500">{i + 1}</span>
        <span class="truncate">{item.title}</span>
      </li>
    ))}
  </ol>
  <p class="mt-4 text-sm font-medium text-sky-700 transition-colors group-hover:text-sky-600 dark:text-sky-400 dark:group-hover:text-sky-300">
    ほか {items.length - PREVIEW_ITEMS} 本を読む
    <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-0.5">
      →
    </span>
  </p>
</article>

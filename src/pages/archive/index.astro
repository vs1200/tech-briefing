---
import Calendar from '../../components/Calendar.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNewsList } from '../../lib/content';
import { formatMonthJa } from '../../lib/date';
import { groupByMonth } from '../../lib/news';
import { monthPath } from '../../lib/url';

const news = await getNewsList();
const months = groupByMonth(news);
const dateKeys = new Set(news.map((n) => n.dateKey));
---

<BaseLayout title="アーカイブ">
  <PageHeader title="アーカイブ" description={`${news.length} 日分のニュースを月ごとに並べています。`} />
  <div class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {months.map(([monthKey, entries]) => (
      <section>
        <Calendar monthKey={monthKey} dateKeys={dateKeys} />
        <a
          href={monthPath(monthKey)}
          class="mt-3 block text-center text-sm font-medium text-sky-700 transition-colors hover:text-sky-600 dark:text-sky-400 dark:hover:text-sky-300"
        >
          {formatMonthJa(monthKey)}の一覧（{entries.length} 日分）<span aria-hidden="true"> →</span>
        </a>
      </section>
    ))}
  </div>
</BaseLayout>

---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Calendar from '../../components/Calendar.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import Mermaid from '../../components/Mermaid.astro';
import PrevNext from '../../components/PrevNext.astro';
import Toc from '../../components/Toc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getItemsWithAnchors, getNewsList, type NewsEntry } from '../../lib/content';
import { formatDateJa, toMonthKey } from '../../lib/date';
import { findNeighbors } from '../../lib/news';

export const getStaticPaths = (async () => {
  const news = await getNewsList();
  return news.map((entry) => ({ params: { date: entry.dateKey }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: NewsEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const items = await getItemsWithAnchors(entry);
const news = await getNewsList();
const { prev, next } = findNeighbors(news, entry.dateKey);
const dateKeys = new Set(news.map((n) => n.dateKey));
const title = formatDateJa(entry.dateKey);
---

<BaseLayout title={title} description={entry.data.summary}>
  <div class="grid gap-12 lg:grid-cols-[minmax(0,46rem)_15rem] lg:justify-between">
    <div class="min-w-0">
      <article data-pagefind-body>
        <header class="mb-8">
          <p class="text-xs font-semibold tracking-wider text-sky-700 dark:text-sky-400">TECH BRIEFING</p>
          <h1
            class="mt-2 text-[1.75rem] leading-tight font-bold text-stone-900 sm:text-[2rem] dark:text-stone-50"
            data-pagefind-meta="title"
          >
            <time datetime={entry.dateKey}>{title}</time>
          </h1>
        </header>

        <nav
          class="mb-12 rounded-xl border border-stone-200 bg-white p-5 sm:p-6 dark:border-stone-800 dark:bg-stone-900"
          aria-labelledby="today-heading"
          data-pagefind-ignore
        >
          <h2 id="today-heading" class="mb-4 text-xs font-bold tracking-wider text-stone-500">
            今日のニュース（{items.length} 本）
          </h2>
          <ol class="space-y-3">
            {items.map((item) => (
              <li class="grid grid-cols-[1.25rem_minmax(0,1fr)] items-baseline gap-x-2">
                <span class="text-right text-sm text-stone-400 tabular-nums dark:text-stone-500">{item.index}</span>
                <div>
                  <a
                    href={`#${item.anchor}`}
                    class="text-[15px] leading-relaxed text-stone-800 transition-colors hover:text-sky-700 dark:text-stone-200 dark:hover:text-sky-300"
                  >
                    {item.title}
                  </a>
                  <div class="mt-1 flex flex-wrap gap-1">
                    {item.categories.map((slug) => (
                      <CategoryBadge slug={slug} />
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </nav>

        <div class="prose max-w-none prose-stone dark:prose-invert prose-headings:text-stone-900 prose-a:text-sky-700 dark:prose-headings:text-stone-50 dark:prose-a:text-sky-400">
          <Content />
        </div>
        <Mermaid />
      </article>

      <PrevNext prev={prev} next={next} />
    </div>

    <aside class="hidden space-y-8 lg:sticky lg:top-24 lg:block lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto lg:pb-4">
      <Calendar monthKey={toMonthKey(entry.dateKey)} dateKeys={dateKeys} current={entry.dateKey} />
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>
